{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "threat_classification_schema.json",
  "title": "Threat Classification Result",
  "description": "Schema for classified posts produced by the NLP Engine and consumed by the Dashboard. Topic: classified-posts.",
  "type": "object",
  "required": [
    "post_id",
    "threat_category",
    "threat_confidence",
    "sentiment",
    "sentiment_intensity",
    "detected_language",
    "model_version",
    "classified_at"
  ],
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Matches post_schema.json post_id."
    },
    "threat_category": {
      "type": "string",
      "enum": ["Inflammatory", "IncitementToViolence", "FakeNews", "Neutral"],
      "description": "Classified threat category."
    },
    "threat_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for the threat classification."
    },
    "sentiment": {
      "type": "string",
      "enum": ["positive", "negative", "neutral"],
      "description": "Overall sentiment of the post."
    },
    "sentiment_intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Intensity of the detected sentiment."
    },
    "detected_language": {
      "type": "string",
      "enum": ["gu", "hi", "en", "mixed"],
      "description": "Detected language of the post."
    },
    "model_version": {
      "type": "string",
      "description": "Identifier for the model version used for classification."
    },
    "classified_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when classification was performed."
    }
  },
  "additionalProperties": false
}
