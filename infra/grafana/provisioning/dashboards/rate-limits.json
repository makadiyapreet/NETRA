      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Remaining API Quota (per platform)",
      "type": "gauge",
      "targets": [
        { "expr": "netra_api_remaining_quota", "legendFormat": "{{platform}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 3}, {"color": "red", "value": 5}] }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
