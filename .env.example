# ============================================================
# NETRA — Environment Configuration
# Copy to .env and fill in values before running.
# ============================================================

# --- Mode ---
# kafka   = consume from real Kafka topics / live API data (DEFAULT)
# fixture = read from fixtures/sample_posts.json (fallback for dev/testing only)
MODE=kafka
#MODE=fixture

# --- Social Media API Credentials ---
# Required for real data ingestion (MODE=kafka). Leave empty to skip that platform.
# Twitter/X API v2 — Bearer token from developer.twitter.com
TWITTER_BEARER_TOKEN=
# YouTube Data API v3 — API key from console.cloud.google.com
YOUTUBE_API_KEY=
# Meta Graph API — Page access token from developers.facebook.com
META_ACCESS_TOKEN=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=nlp-engine-group

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL ---
DATABASE_URL=postgresql://netra:netrasecret@localhost:5432/netra_threat

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=netra

# --- Model Configuration ---
# Path to fine-tuned IndicBERT checkpoint (relative to project root)
INDICBERT_MODEL_PATH=checkpoints/indicbert-threat-v1
# Path to MuRIL checkpoint
MURIL_MODEL_PATH=checkpoints/muril-threat-v1
# Path to Sarvam model checkpoint
SARVAM_MODEL_PATH=checkpoints/sarvam-threat-v1
# Which model to use for inference: zeroshot | indicbert | muril | sarvam
# Zero-shot mode — fine-tuned checkpoints not yet trained; see RUNBOOK_FOR_GPU_TRAINING.md to switch to a fine-tuned model later.
ACTIVE_MODEL=zeroshot
# Model version string (reported in classification output)
MODEL_VERSION=indicbert-v0.1.0-dev

# --- Thresholds ---
# Posts above this confidence AND not Neutral → generate alert
ALERT_CONFIDENCE_THRESHOLD=0.7
# Severity 1-5 is mapped from confidence; this is the minimum severity to emit an alert
ALERT_MIN_SEVERITY=2
# Below this confidence → route to uncertainty sampler for human review
UNCERTAINTY_THRESHOLD=0.5
# MinHash LSH threshold for near-duplicate detection
DUPLICATE_SIMILARITY_THRESHOLD=0.8
# Bot score above this → flag as likely bot
BOT_SCORE_THRESHOLD=0.7

# --- Network Service ---
NETWORK_SERVICE_HOST=0.0.0.0
NETWORK_SERVICE_PORT=8001

# --- NLP Service ---
NLP_SERVICE_HOST=0.0.0.0
NLP_SERVICE_PORT=8000

# --- Ingestion Watchlist API ---
WATCHLIST_API_HOST=0.0.0.0
WATCHLIST_API_PORT=8002

# --- Optional External APIs ---
# PERSPECTIVE_API_KEY=
# FACTCHECK_API_KEY=
# BOTOMETER_API_KEY=
# SARVAM_AKSHAR_API_KEY=

# --- Zero-Shot Classification ---
# Used when ACTIVE_MODEL=zeroshot
SARVAM_API_KEY=
GROQ_API_KEY=

# Telegram Bot API (from @BotFather — https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=